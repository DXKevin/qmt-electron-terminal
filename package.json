{
  "name": "qmt-electron-terminal",
  "private": true,
  "version": "2.2.2",
  "description": "QMTerminal",
  "author": "LE",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "compile:electron": "tsc -p electron/tsconfig.json",
    "electron": "npm run compile:electron && electron .",
    "start": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && npm run electron\"",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.4.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^25.3.0",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.qmtpro.terminal",
    "productName": "QMTerminal",
    "win": {
      "target": "portable",
      "artifactName": "QMTerminal.exe"
    },
    "directories": {
      "output": "bin"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
